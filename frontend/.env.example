# Backend Engine API Base URL
# Local Development: http://localhost:8000
# Cloud Production: https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase Production Database Credentials (Optional Cloud Bridge)
# When provided, ArgusASM syncs perimeter snapshots, drift events, and Merkle roots.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
