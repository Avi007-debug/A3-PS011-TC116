# ============================================================================
# ArgusASM Backend Engine Environment Configuration
# Problem Statement PS-011: Authorised Attack-Surface Inventory & Drift Sentinel
# AIORI Hackathon 2026 - Track: Cybersecurity & Infrastructure Resilience
# ============================================================================

# Service Port and Host Binding (Used by uvicorn or container runtime)
PORT=8000
HOST=0.0.0.0

# Operational Environment (development / production)
ARGUS_ENV=production

# Permitted Scope File Path (Enforces G-01 to G-04 guardrails)
ARGUS_SCOPE_FILE=approved_scope.json

# CORS Allowed Origins (Comma-separated origins or * for open evaluator access)
ARGUS_CORS_ORIGINS=*

# Optional Webhook Alert Dispatcher (R-10 / T3-3: Discord or Slack webhook URL)
ARGUS_ALERT_WEBHOOK_URL=

# Background Scheduler Interval in Seconds (Default: 300)
ARGUS_SCAN_INTERVAL_SECONDS=300

